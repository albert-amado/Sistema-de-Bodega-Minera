# =============================================================================
# SISTEMA DE BODEGA MINERA (SBM) - ARCHIVO DE CONFIGURACIÓN DE ENTORNO (.env.example)
# =============================================================================
# Copie este archivo como '.env' en la raíz del proyecto y configure las
# variables según su entorno de despliegue (Desarrollo, Pruebas o Producción).
# NUNCA suba el archivo '.env' con credenciales reales a control de versiones.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN GENERAL DE DJANGO
# ─────────────────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=cambiar-por-una-clave-secreta-fuerte-y-aleatoria-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
TIME_ZONE=America/Bogota
LANGUAGE_CODE=es-co

# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
DB_TARGET=local
DB_DRIVER=sqlite3
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────────────────────────────
# INTEGRACIÓN OFICIAL SENA / SOFIAPLUS (Módulo de Verificación de Aprendices)
# ─────────────────────────────────────────────────────────────────────────────
# URL base del endpoint oficial o institucional de consulta académica del SENA
# Ejemplo: https://api.sena.edu.co/v1/aprendices o endpoint SOAP/REST entregado
SOFIAPLUS_API_URL=https://api.sena.edu.co/v1/aprendices

# Mecanismo de autenticación acordado con el SENA:
# Opciones disponibles en el cliente:
#   - 'api_key' : Cabecera HTTP X-API-Key (o X-Sena-Api-Key)
#   - 'bearer'  : Token de acceso estático en cabecera 'Authorization: Bearer <TOKEN>'
#   - 'oauth2'  : Flujo OAuth2 Client Credentials (obtiene token dinámico en TOKEN_URL)
SOFIAPLUS_AUTH_TYPE=api_key

# Si SOFIAPLUS_AUTH_TYPE='api_key':
SOFIAPLUS_API_KEY=tu_api_key_entregada_por_el_sena

# Si SOFIAPLUS_AUTH_TYPE='bearer':
SOFIAPLUS_API_TOKEN=tu_bearer_token_autorizado

# Si SOFIAPLUS_AUTH_TYPE='oauth2' (Credenciales de aplicación):
SOFIAPLUS_CLIENT_ID=tu_client_id_sena
SOFIAPLUS_CLIENT_SECRET=tu_client_secret_sena
SOFIAPLUS_TOKEN_URL=https://autenticacion.sena.edu.co/oauth2/token

# Tolerancia a fallos, reintentos y timeouts:
# Tiempo máximo de espera en segundos por petición HTTP antes de abortar
SOFIAPLUS_TIMEOUT=5.0
# Número máximo de reintentos ante fallos temporales (5xx / Timeout) con backoff exponencial
SOFIAPLUS_MAX_RETRIES=2
# Factor multiplicador para el retroceso exponencial (0.5s, 1.0s, etc.)
SOFIAPLUS_BACKOFF_FACTOR=0.5

# Privacidad y Habeas Data (Ley 1581 de 2012):
# Tiempo de vida de la caché en memoria (TTL en segundos). Default: 300 (5 minutos).
# Evita almacenar permanentemente datos sensibles de los aprendices.
SOFIAPLUS_CACHE_TTL=300

# Modo de desarrollo / contingencia local:
# Si es 'True' y las credenciales externas no están configuradas o el servicio externo
# responde que no se encuentra, busca en el registro local de aprendices de la base de datos
# para permitir pruebas funcionales en bodega sin bloquear la operación.
SOFIAPLUS_DEV_FALLBACK=True

# ─────────────────────────────────────────────────────────────────────────────
# POLÍTICAS DE REGISTRO DE USUARIOS Y VERIFICACIÓN SOFIAPLUS
# ─────────────────────────────────────────────────────────────────────────────
# TODO: [DECISIÓN DE NEGOCIO PENDIENTE] ALLOW_MANUAL_REGISTRATION
# Si False, solo permite registrarse a aprendices encontrados en SofiaPlus.
# Si True, permite el registro manual excepcional marcando verificado_sofia_plus=False.
ALLOW_MANUAL_REGISTRATION=False

# TODO: [DECISIÓN DE NEGOCIO PENDIENTE] SOFIAPLUS_FALLBACK_POLICY
# Política cuando el servicio SENA/SofiaPlus no responda (timeout o caída):
# 'ALLOW_PENDING' (Permite registro provisional pendiente de verificación) o 'REJECT' (Rechazo temporal).
SOFIAPLUS_FALLBACK_POLICY=ALLOW_PENDING

